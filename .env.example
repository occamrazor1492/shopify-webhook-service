# Shopify Webhook Service - Environment Variables

# Required Shopify Configuration
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_API_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxx
SHOPIFY_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx
SHOPIFY_API_VERSION=2023-10

# Default tags for all customers
DEFAULT_CUSTOMER_TAGS=new-customer,web-signup

# Instance-Specific Tags (one per Hydrogen frontend)
# Format: CUSTOMER_TAGS_[INSTANCE_IDENTIFIER]
CUSTOMER_TAGS_STORE1=store1,north-america
CUSTOMER_TAGS_STORE2=store2,europe
CUSTOMER_TAGS_MOBILE=mobile-app,rewards-member

# Testing Configuration
# For local testing with test-webhook.js
WEBHOOK_URL=http://localhost:8888/.netlify/functions/customer-tag-webhook

# Logging Configuration (optional)
LOG_LEVEL=info